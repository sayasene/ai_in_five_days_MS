# =============================================================================
# Pursuit Deliverable Auditor — Runtime Environment Template
# Copy to .env for local development. NEVER commit real secrets or API keys.
# In production (Cloud Run), secrets are injected via Google Cloud Secret Manager.
# =============================================================================

# --- Execution Mode & GCP Project ---
ENVIRONMENT=local
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Secret Manager (Production) vs Local Env Fallback ---
# When ENABLE_SECRET_MANAGER=true, secrets are fetched from Google Cloud Secret Manager
# rather than plaintext environment variables.
ENABLE_SECRET_MANAGER=false
GEMINI_API_KEY_SECRET_NAME=pursuit-auditor-gemini-api-key
# Local dev only (set in local .env, never commit):
# GOOGLE_API_KEY=replace-me-locally

# --- Strategic Model Routing Tiers ---
PURSUIT_AUDITOR_FAST_MODEL=gemini-2.5-flash
PURSUIT_AUDITOR_REASONING_MODEL=gemini-2.5-pro

# --- Persistent Session & Precedent Vector Store ---
# Options: sqlite (local persistent DB), cloud_sql (PostgreSQL URI), vertex_ai
SESSION_BACKEND=sqlite
SESSION_DB_URL=sqlite+aiosqlite:///./data/pursuit_auditor_sessions.db
PRECEDENT_DB_PATH=./data/pursuit_auditor_precedents.db
# Optional GCP Vertex AI Search datastore for enterprise precedent retrieval:
VERTEX_AI_SEARCH_DATASTORE_ID=

# --- Async Memory Consolidation ---
MEMORY_BACKEND=in_memory
# For Vertex AI Memory Bank in production, set MEMORY_BACKEND=vertex_ai and:
AGENT_ENGINE_ID=

# --- Context Compaction & Caching ---
COMPACTION_INTERVAL_EVENTS=12
COMPACTION_OVERLAP_EVENTS=3
CONTEXT_CACHE_MIN_TOKENS=2048
CONTEXT_CACHE_TTL_SECONDS=1800

# --- Guardrails & Safety (Google Cloud Model Armor + Cloud DLP) ---
ENABLE_MODEL_ARMOR=false
MODEL_ARMOR_TEMPLATE_ID=
ENABLE_CLOUD_DLP=false
DLP_DEIDENTIFY_TEMPLATE_ID=

# --- Observability & OpenTelemetry ---
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=pursuit-auditor-agent
OTEL_EXPORTER_MODE=none
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
